# Strava API credentials
# 1. Create an app at https://www.strava.com/settings/api
# 2. Authorize it to get a refresh token (see README or Strava docs)
# 3. Copy this file to .env and fill in your values:
#      cp .env.example .env

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Instagram Graph API
# 1. Create a Meta app at https://developers.facebook.com
# 2. Add the "Instagram" product, connect your Business/Creator account
# 3. Generate a long-lived token from the Graph API Explorer
# 4. Token lasts 60 days — `npm run sync:instagram` auto-refreshes it

INSTAGRAM_ACCESS_TOKEN=
